<Window x:Class="Ezmacro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ezmacro"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="#2D2D30" Margin="0">
            <TextBlock Text="MACRO ENGINE" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

            <Button Name="BtnRecord" Content="🔴 Record" Margin="0,5" Padding="8" Background="#FF4444" Foreground="White" FontWeight="Bold" Click="BtnRecord_Click"/>
            <Button Name="BtnStop" Content="⏹️ Stop" Margin="0,5" Padding="8" Background="#555555" Foreground="White" FontWeight="Bold" PreviewMouseDown="BtnStop_Click" IsEnabled="False"/>
            <Button Name="BtnPlay" Content="▶️ Playback" Margin="0,5,0,25" Padding="8" Background="#4CAF50" Foreground="White" FontWeight="Bold" Click="BtnPlay_Click"/>

            <Button Name="BtnSave" Content="💾 Save Macro" Margin="0,5" Padding="5" Click="BtnSave_Click"/>
            <Button Name="BtnLoad" Content="📂 Load Macro" Margin="0,5" Padding="5" Click="BtnLoad_Click"/>
            <Button Name="BtnSettings" Content="Settings" Margin="0,5" Padding="5" Click="BtnSettings_Click"/>
        </StackPanel>

        <Grid Grid.Column="1" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Recorded Actions List" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
            

            <DataGrid 
                Name="MacroDataGrid" 
                Grid.Row="1" 
                AutoGenerateColumns="False" 
                CanUserAddRows="False" 
                CanUserDeleteRows="True" 
                SelectionMode="Single"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                AllowDrop="True"
                CanUserSortColumns="False"
                Drop="MacroDataGrid_Drop"
                Background="White" 
                RowHeaderWidth="0">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <EventSetter Event="DragOver" Handler="DataGridRow_DragOver"/>
                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="DataGridRow_PreviewMouseLeftButtonDown"/>
                        <EventSetter Event="MouseMove" Handler="DataGridRow_MouseMove"/>
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Margin" Value="0,1,0,1" />

                        <Style.Triggers>
                           <!-- Mouse Hover Highlight -->
                           <Trigger Property="IsMouseOver" Value="True">
                           <Setter Property="Background" Value="#E5F3FF" />
                        </Trigger>

                        <!-- Selected Row Highlight -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#007ACC" />
                            <Setter Property="Foreground" Value="White" />
                           <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridComboBoxColumn Header="Action Type" 
                                SelectedItemBinding="{Binding ActionType, UpdateSourceTrigger=PropertyChanged}" 
                                Width="120">
                        <DataGridComboBoxColumn.ItemsSource>
                            <x:Array Type="{x:Type sys:String}" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                                <sys:String>KeyPress</sys:String>
                                <sys:String>KeyRelease</sys:String>
                                <sys:String>MousePress</sys:String>
                                <sys:String>MouseRelease</sys:String>
                                <sys:String>MouseMove</sys:String>
                            </x:Array>
                        </DataGridComboBoxColumn.ItemsSource>
                    </DataGridComboBoxColumn>
                    
                    <DataGridTextColumn Header="Key / Detail" Binding="{Binding Detail, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                    <DataGridTextColumn Header="X Pos" Binding="{Binding X, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                    <DataGridTextColumn Header="Y Pos" Binding="{Binding Y,UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                    <DataGridTextColumn Header="Delay (ms)" Binding="{Binding Delay, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                    <DataGridTemplateColumn Width="*"/>
                    <DataGridTemplateColumn Header="Actions" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="✕" 
                            Width="30" 
                            Height="22" 
                            Background="#FFECEC" 
                            Foreground="Red" 
                            BorderBrush="Transparent"
                            FontWeight="Bold"
                            ToolTip="Remove this action"
                            Click="BtnDeleteRow_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <Button Content="Add Action..." Click="BtnOpenAddWindow_Click" Width="100"/>
            
        </Grid>
        
    </Grid>
</Window>

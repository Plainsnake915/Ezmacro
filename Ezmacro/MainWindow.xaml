<Window x:Class="Ezmacro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:Ezmacro"
        mc:Ignorable="d"
        Title="EzMacro" Height="500" Width="900"
        FontFamily="Segoe UI"
        Background="#121319">

    <Window.Resources>

        <!-- ================= PALETTE (Dark) ================= -->
        <SolidColorBrush x:Key="AppBg" Color="#121319"/>
        <SolidColorBrush x:Key="SidebarBg" Color="#191A22"/>
        <SolidColorBrush x:Key="CardBg" Color="#1D1F29"/>
        <SolidColorBrush x:Key="HeaderBg" Color="#22232F"/>
        <SolidColorBrush x:Key="BorderSubtle" Color="#2B2D3A"/>
        <SolidColorBrush x:Key="Accent" Color="#5B8CFF"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#2E4270"/>
        <SolidColorBrush x:Key="Danger" Color="#F0555B"/>
        <SolidColorBrush x:Key="Success" Color="#3FBE82"/>
        <SolidColorBrush x:Key="Disabled" Color="#2E2F3B"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E7E8EE"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8B8D9C"/>
        <SolidColorBrush x:Key="TextFaint" Color="#5C5E6E"/>
        <SolidColorBrush x:Key="RowHover" Color="#2C3040"/>

        <!-- Left accent strip shown via the row header column — kept separate from
             BorderThickness/BorderBrush so it never conflicts with the drag-over indicator. -->
        <Style x:Key="RowIndicatorHeaderStyle" TargetType="DataGridRowHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRowHeader">
                        <Border Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsMouseOver}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Accent}"/>
                    <Setter Property="Opacity" Value="0.5"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Accent}"/>
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ================= ICON FONT SHORTCUT ================= -->
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ================= SIDEBAR BUTTON ================= -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="16,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#252735"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Disabled}"/>
                                <Setter Property="Foreground" Value="#57596A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarButtonGhost" TargetType="Button" BasedOn="{StaticResource SidebarButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A9ABBC"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Height" Value="34"/>
        </Style>

        <!-- ================= FLOATING ADD BUTTON (FAB) ================= -->
        <Style x:Key="FabButton" TargetType="Button">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="26">
                            <Border.Effect>
                                <DropShadowEffect Color="#5B8CFF" Opacity="0.45" BlurRadius="18" ShadowDepth="3" Direction="270"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#6E99FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4A76E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= ROW DELETE BUTTON ================= -->
        <Style x:Key="RowDeleteButton" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Foreground" Value="{StaticResource Danger}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A2530"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= DATAGRID ================= -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- x:Key is required here: DataGrid.CellStyle has its own non-null default from the
             WPF theme, so an *implicit* Style (TargetType only) is silently ignored — it never
             overrides the default, which is why cells were staying white/blue regardless of
             the row triggers below. We assign this explicitly via DataGrid.CellStyle. -->
        <Style x:Key="DataGridCellStyleModern" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBg}">
            <DockPanel LastChildFill="False">

                <StackPanel DockPanel.Dock="Top" Margin="0,24,0,28">
                    <TextBlock Text="EZMACRO" Foreground="White" FontSize="16" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,0,0,2"/>
                    <TextBlock Text="MACRO ENGINE" Foreground="{StaticResource TextFaint}" FontSize="10" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <Button Name="BtnRecord" Style="{StaticResource SidebarButton}" Background="{StaticResource Danger}" Click="BtnRecord_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEA0C;" Style="{StaticResource Icon}" Margin="0,0,10,0"/>
                            <TextBlock Text="Record" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Name="BtnStop" Style="{StaticResource SidebarButton}" PreviewMouseDown="BtnStop_Click" IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71A;" Style="{StaticResource Icon}" Margin="0,0,10,0"/>
                            <TextBlock Text="Stop" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Name="BtnPlay" Style="{StaticResource SidebarButton}" Background="{StaticResource Success}" Click="BtnPlay_Click" Margin="16,4,16,24">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" Margin="0,0,10,0"/>
                            <TextBlock Text="Playback" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Height="1" Background="{StaticResource BorderSubtle}" Margin="16,0,16,16"/>

                    <Button Name="BtnSave" Style="{StaticResource SidebarButtonGhost}" Click="BtnSave_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" Margin="0,0,10,0"/>
                            <TextBlock Text="Save Macro" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Name="BtnLoad" Style="{StaticResource SidebarButtonGhost}" Click="BtnLoad_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" Margin="0,0,10,0"/>
                            <TextBlock Text="Load Macro" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Name="BtnSettings" Style="{StaticResource SidebarButtonGhost}" Click="BtnSettings_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" Margin="0,0,10,0"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ================= CONTENT ================= -->
        <Grid Grid.Column="1" Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="Recorded Actions" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="Drag rows to reorder — click a row to select it" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
            </StackPanel>

            <Border Grid.Row="1" Background="{StaticResource CardBg}" CornerRadius="10" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
                <DataGrid
                    Name="MacroDataGrid"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="True"
                    SelectionMode="Single"
                    GridLinesVisibility="None"
                    HeadersVisibility="Column"
                    AllowDrop="True"
                    CanUserSortColumns="False"
                    Drop="MacroDataGrid_Drop"
                    Background="Transparent"
                    
                    CellStyle="{StaticResource DataGridCellStyleModern}"
                    RowHeaderStyle="{StaticResource RowIndicatorHeaderStyle}"
                    BorderThickness="0"
                    RowHeaderWidth="4"
                    RowHeight="38"
                    Margin="4">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <EventSetter Event="DragOver" Handler="DataGridRow_DragOver"/>
                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="DataGridRow_PreviewMouseLeftButtonDown"/>
                            <EventSetter Event="MouseMove" Handler="DataGridRow_MouseMove"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>

                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource RowHover}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridComboBoxColumn Header="ACTION TYPE"
                                    SelectedItemBinding="{Binding ActionType, UpdateSourceTrigger=PropertyChanged}"
                                    Width="130">
                            <DataGridComboBoxColumn.ItemsSource>
                                <x:Array Type="{x:Type sys:String}">
                                    <sys:String>KeyPress</sys:String>
                                    <sys:String>KeyRelease</sys:String>
                                    <sys:String>MousePress</sys:String>
                                    <sys:String>MouseRelease</sys:String>
                                    <sys:String>MouseMove</sys:String>
                                </x:Array>
                            </DataGridComboBoxColumn.ItemsSource>
                        </DataGridComboBoxColumn>

                        <DataGridTextColumn Header="KEY / DETAIL" Binding="{Binding Detail, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                        <DataGridTextColumn Header="X POS" Binding="{Binding X, UpdateSourceTrigger=PropertyChanged}" Width="65"/>
                        <DataGridTextColumn Header="Y POS" Binding="{Binding Y, UpdateSourceTrigger=PropertyChanged}" Width="65"/>
                        <DataGridTextColumn Header="DELAY (MS)" Binding="{Binding Delay, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                        <DataGridTemplateColumn Width="*"/>
                        <DataGridTemplateColumn Header="" Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="&#xE711;"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="12"
                                            Style="{StaticResource RowDeleteButton}"
                                            ToolTip="Remove this action"
                                            Click="BtnDeleteRow_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Floating "+" add button, bottom-right of content area -->
            <Button Grid.Row="2" Name="BtnOpenAddWindow" Style="{StaticResource FabButton}"
                    HorizontalAlignment="Right" Margin="0,16,4,0"
                    ToolTip="Add Action"
                    Click="BtnOpenAddWindow_Click">
                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="White"/>
            </Button>

        </Grid>
    </Grid>
</Window>

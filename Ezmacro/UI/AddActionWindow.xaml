<Window x:Class="Ezmacro.AddActionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ezmacro"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Add New Action" Height="420" Width="400"
        MinHeight="300"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI"
        Background="{StaticResource AppBg}">

    <!-- Window-specific interaction rules, kept local (not in Styles.xaml) since they
         bind to CmbActionType by name and only make sense in this window's tree. -->
    <Window.Resources>
        <ResourceDictionary>

            <!-- Key/Button: enabled for everything except MouseMove (which has no key/button) -->
            <Style x:Key="KeyDetailSection" TargetType="Grid" BasedOn="{StaticResource DimmableSection}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ElementName=CmbActionType, Path=SelectedItem}" Value="MouseSet">
                        <Setter Property="IsEnabled" Value="False"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- X/Y Position: disabled by default, only enabled for MousePress or MouseMove -->
            <Style x:Key="PositionSection" TargetType="Grid" BasedOn="{StaticResource DimmableSection}">
                <Setter Property="IsEnabled" Value="False"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ElementName=CmbActionType, Path=SelectedItem}" Value="MousePress">
                        <Setter Property="IsEnabled" Value="True"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ElementName=CmbActionType, Path=SelectedItem}" Value="MouseRelease">
                        <Setter Property="IsEnabled" Value="True"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ElementName=CmbActionType, Path=SelectedItem}" Value="MouseSet">
                        <Setter Property="IsEnabled" Value="True"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24,22,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Add New Action" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
            <TextBlock Text="Define a single macro step" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Scrollable body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,4,0">

                <!-- Action Type -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Action Type" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="CmbActionType" Style="{StaticResource DarkComboBox}"
                              SelectionChanged="CmbActionType_SelectionChanged">
                        <sys:String>KeyPress</sys:String>
                        <sys:String>KeyRelease</sys:String>
                        <sys:String>MousePress</sys:String>
                        <sys:String>MouseRelease</sys:String>
                        <sys:String>MouseSet</sys:String>
                    </ComboBox>
                </StackPanel>

                <!-- Detail / Key — unavailable for MouseMove -->
                <Grid Style="{StaticResource KeyDetailSection}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="LblDetail" Text="Key / Button" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CmbDetail" Style="{StaticResource DarkComboBox}" IsEditable="True"/>
                    </StackPanel>
                </Grid>

                <!-- X / Y Position — only available for MousePress or MouseMove -->
                <Grid Style="{StaticResource PositionSection}" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="X Position" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtX" Text="0" Style="{StaticResource DarkTextBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Y Position" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtY" Text="0" Style="{StaticResource DarkTextBox}"/>
                    </StackPanel>
                </Grid>

                <!-- Delay -->
                <StackPanel Margin="0,0,0,4">
                    <TextBlock Text="Delay (ms)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TxtDelay" Text="100" Style="{StaticResource DarkTextBox}"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{StaticResource GhostButton}" Margin="0,0,10,0" IsCancel="True" Click="BtnCancel_Click"/>
            <Button Content="Add Action" Style="{StaticResource PrimaryButton}" Width="110" IsDefault="True" Click="BtnAdd_Click"/>
        </StackPanel>

    </Grid>
</Window>

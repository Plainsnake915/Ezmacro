<Window x:Class="Ezmacro.GlowOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ezmacro"
        mc:Ignorable="d"
        Title="GlowOverlayWindow" Height="450" Width="800"
        AllowsTransparency="True"
        WindowStyle="None" Background="Transparent" Topmost="True"
        ShowInTaskbar="False"
        IsHitTestVisible="False"
        WindowStartupLocation="Manual">

    <Border x:Name="GlowBorder"
            BorderThickness="6"
            BorderBrush="Red"
            Margin="0">
        <Border.Effect>
            <DropShadowEffect x:Name="GlowEffect"
                              Color="Red"
                              BlurRadius="20"
                              ShadowDepth="0"
                              Opacity=".08"/>
        </Border.Effect>
    </Border>
</Window>
